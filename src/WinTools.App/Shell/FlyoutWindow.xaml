<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinTools.App.Shell.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:brightness="using:WinTools.App.Features.Brightness"
    Title="WinTools">
    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Padding="16" Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="Monitor Brightness" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <brightness:BrightnessPanel x:Name="BrightnessSection" x:FieldModifier="public" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
