<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinTools.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WinToolsFallbackBackgroundBrush" Color="#0F0F1E" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#6363F1" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#7878F3" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#5555D8" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#6363F1" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#7878F3" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#5555D8" />
                    <SolidColorBrush x:Key="WinToolsAccentTextBrush" Color="#8C8CF5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
